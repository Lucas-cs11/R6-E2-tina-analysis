+    (folder / 'observed.json').write_text(json.dumps(got, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
+    return {'mutation': name, 'target': target_case, 'detected': detected, 'observed': got['verdict'], 'expected': expected}
+
